          "action_buttons": false,
          "activity_log": false,
          "vehicle_hud": false,
          "johnny_hud": false,
          "DamageDigitsInterpolation": false,
          "HitIndicator": false,
          "FluffReduction": true,
          "PostProcessingReduction": true,
          "Sieja": true
        }
      }
    }
