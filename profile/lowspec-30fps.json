      "CascadeFitToWorstCase": "False",
      "CascadeUseBackfacesAsCullingPlanes": "False"
    },
    "Occlusion": {
      "MultiFrustumUseGlobalOcclusion": "False"
    },
    "Streaming/Culling": {
      "VisibilityQuery": "False"
    },
