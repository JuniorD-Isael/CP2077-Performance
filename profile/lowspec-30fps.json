    "Streaming/Culling/SecondaryRefPoint": {
      "Enabled": "False"
    },
    "Crowd": {
      "ZCutoffEnabled": "False"
    },
    "Animation": {
      "UseAnimSetupCaching": "False",
      "EnableRefreshLocoWrappersOnUnlock": "False"
    },
    "Lipsync": {
      "SyncToAudio": "False",
      "UseAudioAdjustment": "False"
    },
    "Editor/Characters/Hair": {
      "UseGlobalContactShadowsOnHair": "False",
      "UseLocalContactShadowsOnHair": "False"
    },
    "Vehicle": {
      "EnableAirResistance": "False",
      "PhysXClampHugeImpacts": "False",
      "PhysXClampHugeSpeeds": "False"
    },
    "SnapToTerrainIk": {
      "Enabled": "False",
      "FootLockEnabled": "False"
    }
