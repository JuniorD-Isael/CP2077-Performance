  "cetConfig": {
    "_comment": "Patches do Cyber Engine Tweaks. Afetam o motor inteiro, nao so opcoes de menu.",
    "patches": {
      "disable_antialiasing": true,
      "disable_async_compute": true,
      "disable_vignette": true,
      "disable_win7_vsync": true
    }
  },
  "variants": {
    "hudMinimal": {
      "label": "HUD minima",
      "description": "Reduz a interface do jogo: minimapa, marcadores, nomes, barra de vida, rastreador de missoes e afins. Cada elemento desligado e um draw call a menos na GPU, que e o gargalo deste hardware.",
      "userSettings": {
        "values": {
          "minimap": false,
          "CrowdsOnMinimap": false,
          "object_markers": false,
          "npc_nameplates": false,
          "npc_names": false,
          "npc_healthbar": false,
          "healthbar": false,
          "stamina_oxygen": false,
          "wanted_level": false,
          "quest_tracker": false,
          "hud_markers": false,
          "input_hints": false,
          "ammo_counter": false,
          "crosshairs": false,
