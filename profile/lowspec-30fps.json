{
  "$schema": "./profile.schema.json",
  "name": "Low-Spec 30 FPS",
  "version": "0.1.1-alpha",
  "target": {
    "cpu": "AMD Ryzen 5 5500U (6C/12T, 2.1 GHz)",
    "gpu": "AMD Radeon Vega 8 (integrated, shared VRAM)",
    "ram": "20 GB",
    "goal_fps": 30,
    "note": "Perfil validado para GPU integrada sem VRAM dedicada. Preserva cabelo (Hair) e todos os mods instalados."
  },
  "preserve": {
    "comment": "NUNCA alterar. Desligar quebra lightmaps ou removes cabelo (requisito do usuario).",
    "userIni": {
      "Developer/FeatureToggles": {
        "DistantShadows": "True",
        "GlobalIllumination": "True",
        "Hair": "True"
      }
    },
    "userSettings": {
      "RayTracing": false,
      "RayTracedReflections": false,
      "RayTracedSunShadows": false,
      "RayTracedLocalShadows": false
    }
  },
  "userIni": {
    "_comment": "Grupos extras que o ConfigOverhaul nao alcanca (bug: so cria Developer/Rendering/RayTracing).",
    "Developer/FeatureToggles": {
      "Antialiasing": "False",
      "Bloom": "False",
      "CharacterLightBlockers": "False",
      "CharacterRimEnhancement": "False",
      "CharacterSubsurfaceScattering": "False",
      "ChromaticAberration": "False",
      "ContactShadows": "False",
      "DepthOfField": "False",
      "DistantFog": "False",
      "DistantGI": "False",
      "DistantVolFog": "False",
      "DynamicDecals": "False",
      "FilmGrain": "False",
      "ImageBasedFlares": "False",
      "LocalShadows": "False",
